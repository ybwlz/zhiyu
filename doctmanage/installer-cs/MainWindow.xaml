<Window x:Class="ZhiyuInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZhiyuInstaller"
        Title="知屿安装" Width="860" Height="600" Icon="icon.ico"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <Grid>
        <!-- 深蓝半透明渐变滤镜（复刻 Electron 精确值：左上 28% 蓝 → 右下 90% 深蓝，桌面清晰透出） -->
        <Border CornerRadius="16">
            <Border.Background>
                <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="1.2" RadiusY="1.2">
                    <GradientStop Color="#473B82F6" Offset="0" />
                    <GradientStop Color="#D10F172A" Offset="0.55" />
                    <GradientStop Color="#E6020617" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- 右上蓝色光晕 -->
        <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-120,-80,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#593B82F6" Offset="0" />
                    <GradientStop Color="#003B82F6" Offset="0.65" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 星空（DrawingContext 精确绘制） -->
        <local:StarsCanvas IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown" Background="Transparent">
                <TextBlock Text="知屿" Foreground="#E6E8ECF8" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="18,0,0,0" Opacity="0.9" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button Content="─" Width="34" Height="26" Style="{StaticResource TbBtn}" Click="BtnMin_OnClick" />
                    <Button Content="✕" Width="34" Height="26" Style="{StaticResource TbBtnClose}" Click="BtnClose_OnClick" />
                </StackPanel>
            </Grid>

            <!-- 页面容器 -->
            <Grid Grid.Row="1" Margin="48,20,48,36">

                <!-- ① 欢迎页 -->
                <StackPanel x:Name="PageWelcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center" Background="{StaticResource BrandGrad}">
                        <Viewbox Width="46" Height="46" Stretch="Uniform">
                            <Grid Width="64" Height="64">
                                <Path Data="M31 7 C 37 7, 39 11, 34 16 A 10 10 0 0 0 34 36 A 16 16 0 0 0 34 58 A 16 16 0 0 0 34 26"
                                      Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="知屿 " Foreground="White" FontSize="42" FontWeight="Black" />
                        <TextBlock Text="✦" Foreground="#93C5FD" FontSize="22" FontWeight="Black" VerticalAlignment="Top" Margin="2,6,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#93C5FD" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="把散落的笔记、截图与灵感，&#10;汇成一座属于自己的知识岛。" Foreground="#E6E8ECF8"
                               FontSize="17" TextAlignment="Center" LineHeight="30" Margin="0,14,0,0" Opacity="0.92" />
                    <TextBlock Text="个人知识库 · 笔记 / 截图 / AI 助手 / 收藏，云端同步，随处访问。" Foreground="#9EE8ECF8"
                               FontSize="13" TextAlignment="Center" Margin="0,8,0,0" />
                    <Button Content="开始安装 →" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Center"
                            Margin="0,30,0,0" Click="BtnStart_OnClick" />
                    <Button x:Name="BtnUninstall" Content="卸载知屿" Style="{StaticResource BtnDanger}" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Click="BtnUninstall_OnClick" Visibility="Collapsed" />
                </StackPanel>

                <!-- ② 功能预览页 -->
                <StackPanel x:Name="PagePreview" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="17" Background="{StaticResource BrandGrad}" Margin="0,0,16,0">
                            <Viewbox Width="34" Height="34" Stretch="Uniform">
                                <Grid Width="64" Height="64">
                                    <Path Data="M31 7 C 37 7, 39 11, 34 16 A 10 10 0 0 0 34 36 A 16 16 0 0 0 34 58 A 16 16 0 0 0 34 26"
                                          Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="一座知识岛，装下你的一切" Foreground="White" FontSize="22" FontWeight="Black" />
                            <TextBlock Text="笔记、截图、灵感、AI，全都安放在一起。" Foreground="#9EE8ECF8" FontSize="13" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <UniformGrid Columns="3" Margin="0,22,0,0">
                        <Border Style="{StaticResource FeatCard}" Margin="0,0,7,0"><StackPanel><Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B82F6" Offset="0"/><GradientStop Color="#2563EB" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="📝" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Markdown 笔记" Style="{StaticResource FeatName}"/><TextBlock Text="代码高亮、公式渲染、自定义容器，把笔记写得漂亮。" Style="{StaticResource FeatDesc}"/></StackPanel></Border>
                        <Border Style="{StaticResource FeatCard}" Margin="7,0,7,0"><StackPanel><Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F59E0B" Offset="0"/><GradientStop Color="#D97706" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="✂️" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="截图与附件" Style="{StaticResource FeatName}"/><TextBlock Text="粘贴即存、图片可拉伸标注，灵感随手收下。" Style="{StaticResource FeatDesc}"/></StackPanel></Border>
                        <Border Style="{StaticResource FeatCard}" Margin="7,0,0,0"><StackPanel><Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#6D28D9" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="🤖" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="AI 助手" Style="{StaticResource FeatName}"/><TextBlock Text="DeepSeek 驱动：问答、总结、辅助写作，随叫随到。" Style="{StaticResource FeatDesc}"/></StackPanel></Border>
                        <Border Style="{StaticResource FeatCard}" Margin="0,7,7,0"><StackPanel><Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0EA5E9" Offset="0"/><GradientStop Color="#0284C7" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="⛅" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="云端同步" Style="{StaticResource FeatName}"/><TextBlock Text="网页 / 桌面多端登录，笔记随时随取。" Style="{StaticResource FeatDesc}"/></StackPanel></Border>
                        <Border Style="{StaticResource FeatCard}" Margin="7,7,7,0"><StackPanel><Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10B981" Offset="0"/><GradientStop Color="#059669" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="📚" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="阅览室与广场" Style="{StaticResource FeatName}"/><TextBlock Text="收藏、阅读、分享，构建自己的知识体系。" Style="{StaticResource FeatDesc}"/></StackPanel></Border>
                        <Border Style="{StaticResource FeatCard}" Margin="7,7,0,0"><StackPanel><Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EC4899" Offset="0"/><GradientStop Color="#DB2777" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="🎨" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="多主题界面" Style="{StaticResource FeatName}"/><TextBlock Text="深空星际 / 晴空 / 简约，风格随你切换。" Style="{StaticResource FeatDesc}"/></StackPanel></Border>
                    </UniformGrid>

                    <Grid Margin="0,30,0,0">
                        <Button Content="← 上一步" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Click="BtnPvBack_OnClick" />
                        <Button Content="下一步：选择主题 →" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Click="BtnPvNext_OnClick" />
                    </Grid>
                </StackPanel>

                <!-- ③ 主题选择页 -->
                <StackPanel x:Name="PageTheme" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="选择你的主题" Foreground="White" FontSize="24" FontWeight="Black" />
                    <TextBlock Text="安装后默认使用，随时可在设置里切换。" Foreground="#9EE8ECF8" FontSize="13" Margin="0,10,0,20" />

                    <Border Style="{StaticResource ThemeRow}" MouseLeftButtonDown="PickTheme" Tag="starlight" x:Name="RowStarlight" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="深空星际" Style="{StaticResource ThemeName}" Margin="0,0,0,0" />
                                    <Border Background="#3B82F6" CornerRadius="8" Padding="8,2" Margin="6,0,0,2" VerticalAlignment="Center">
                                        <TextBlock Text="默认" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="深邃蓝紫夜空，沉浸式阅读，暗光环境更护眼。" Style="{StaticResource ThemeDesc}" />
                            </StackPanel>
                            <Border Width="150" Height="52" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B1226" Offset="0"/><GradientStop Color="#1E3A8A" Offset="1"/></LinearGradientBrush></Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ThemeRow}" MouseLeftButtonDown="PickTheme" Tag="sky" x:Name="RowSky" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="晴空" Style="{StaticResource ThemeName}" />
                                <TextBlock Text="清爽浅蓝天空，明亮通透，白天用着舒服。" Style="{StaticResource ThemeDesc}" />
                            </StackPanel>
                            <Border Width="150" Height="52" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E8F4FF" Offset="0"/><GradientStop Color="#7DB9F0" Offset="1"/></LinearGradientBrush></Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ThemeRow}" MouseLeftButtonDown="PickTheme" Tag="minimal" x:Name="RowMinimal">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="简约" Style="{StaticResource ThemeName}" />
                                <TextBlock Text="干净灰白，少干扰，专注内容本身。" Style="{StaticResource ThemeDesc}" />
                            </StackPanel>
                            <Border Width="150" Height="52" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F5F5F5" Offset="0"/><GradientStop Color="#E0E0E0" Offset="1"/></LinearGradientBrush></Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Margin="0,30,0,0">
                        <Button Content="← 上一步" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Click="BtnThBack_OnClick" />
                        <Button Content="下一步 →" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Click="BtnThNext_OnClick" />
                    </Grid>
                </StackPanel>

                <!-- ④ 配置页 -->
                <StackPanel x:Name="PageConfig" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="安装配置" Foreground="White" FontSize="24" FontWeight="Black" />
                    <TextBlock Text="安装位置" Foreground="#9EE8ECF8" FontSize="13" Margin="0,20,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <TextBlock x:Name="TxtDir" Foreground="#E6E8ECF8" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BtnGhost}" Margin="10,0,0,0" Click="BtnBrowse_OnClick" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <CheckBox x:Name="ChkShortcut" Content="创建桌面快捷方式" Style="{StaticResource OptCheck}" IsChecked="True" />
                        <CheckBox x:Name="ChkAutoStart" Content="开机自启动" Style="{StaticResource OptCheck}" IsChecked="True" Margin="26,0,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0">
                        <CheckBox x:Name="ChkAgree" Style="{StaticResource OptCheck}" IsChecked="True">
                            <TextBlock Foreground="#E6E8ECF8" FontSize="13.5">
                                我已阅读并同意<Hyperlink Foreground="#3B82F6" TextDecorations="Underline" Click="LinkTerms_OnClick">《服务条款》</Hyperlink>和<Hyperlink Foreground="#3B82F6" TextDecorations="Underline" Click="LinkPrivacy_OnClick">《隐私协议》</Hyperlink>
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                    <Grid Margin="0,30,0,0">
                        <Button Content="← 上一步" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Click="BtnConfigBack_OnClick" />
                        <Button Content="安装" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Click="BtnInstall_OnClick" />
                    </Grid>
                </StackPanel>

                <!-- ⑤ 进度页 -->
                <StackPanel x:Name="PageProgress" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="正在安装" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" />
                    <Border Height="14" CornerRadius="7" Background="#143B82F6" Margin="0,28,0,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <Grid>
                            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="7" Background="{StaticResource BrandGrad}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ProgressTxt" Text="准备中…" Foreground="#9EE8ECF8" FontSize="13.5" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock x:Name="ProgressPct" Text="0%" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <!-- ⑥ 完成页 -->
                <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center" Background="{StaticResource DoneGrad}">
                        <TextBlock Text="✓" Foreground="White" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="安装完成" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock x:Name="DoneTxt" Text="" Foreground="#9EE8ECF8" FontSize="13.5" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Content="完成" Style="{StaticResource BtnGhost}" Click="BtnFinish_OnClick" />
                        <Button Content="启动知屿" Style="{StaticResource BtnPrimary}" Margin="12,0,0,0" Click="BtnLaunch_OnClick" />
                    </StackPanel>
                </StackPanel>

                <!-- ⑦ 卸载确认页 -->
                <StackPanel x:Name="PageUninstall" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center" Background="{StaticResource BrandGrad}">
                        <Viewbox Width="40" Height="40" Stretch="Uniform">
                            <Grid Width="64" Height="64">
                                <Path Data="M31 7 C 37 7, 39 11, 34 16 A 10 10 0 0 0 34 36 A 16 16 0 0 0 34 58 A 16 16 0 0 0 34 26"
                                      Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="卸载知屿？" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock x:Name="UninstallDirTxt" Text="" Foreground="#9EE8ECF8" FontSize="13.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="你的云端笔记数据不受影响（保存在服务器）。" Foreground="#9EE8ECF8" FontSize="13" TextAlignment="Center" Margin="0,8,0,0" />
                    <CheckBox x:Name="ChkPurgeData" Content="同时删除本地个人数据（登录状态、主题设置）" Style="{StaticResource OptCheck}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    <Grid Margin="0,30,0,0" Width="420">
                        <Button Content="取消" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Click="BtnUninstallCancel_OnClick" />
                        <Button Content="确认卸载" Style="{StaticResource BtnDanger}" HorizontalAlignment="Right" Click="BtnUninstallGo_OnClick" />
                    </Grid>
                </StackPanel>

            </Grid>
        </Grid>

        <!-- 条款弹窗 -->
        <Grid x:Name="TermsModal" Visibility="Collapsed" Background="#99020617" Panel.ZIndex="50"
              MouseLeftButtonDown="TermsModal_OnClick">
            <Border Width="520" Height="440" Background="#EB0F172A" CornerRadius="18"
                    BorderBrush="#1FFFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <TextBlock x:Name="TermsTitle" Text="服务条款" Foreground="White" FontSize="15" FontWeight="Bold" />
                        <Button Content="✕" Width="34" Height="26" Style="{StaticResource TbBtnClose}"
                                HorizontalAlignment="Right" Click="BtnTermsClose_OnClick" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="22,10,22,18" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TermsBody" Foreground="#9EE8ECF8" FontSize="13" LineHeight="28" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
